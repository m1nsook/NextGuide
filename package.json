{
  "name": "nextguide-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/nextguide",
    "packages/eslint-config",
    "packages/typescript-config"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/nextguide build && turbo dev --filter=web",
    "build": "turbo run build",
    "build:packages": "bun run --cwd packages/nextguide build",
    "build:web": "turbo run build --filter=web",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx}\"",
    "pack:dev": "bun run --cwd packages/nextguide test && npm pack ./packages/nextguide --ignore-scripts",
    "compat:next": "bun run build:packages && node scripts/verify-generated-starter.mjs",
    "compat:account": "bun run build:packages && node scripts/verify-generated-account-mode.mjs"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
