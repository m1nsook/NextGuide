{
  "name": "@nextguide-internal/openapi",
  "version": "0.0.1-alpha.2",
  "type": "module",
  "author": "NextGuide contributors",
  "license": "MIT",
  "description": "NextGuide internal openapi build module (not published separately).",
  "keywords": [
    "openapi",
    "swagger",
    "documentation",
    "parser",
    "api",
    "headless",
    "nextguide"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "node ../../scripts/clean-dist.mjs && tsc",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@nextguide-internal/core": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3",
    "eslint": "^9.32.0"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m1nsook/NextGuide.git",
    "directory": "packages/lib-openapi"
  },
  "bugs": {
    "url": "https://github.com/m1nsook/NextGuide/issues"
  },
  "homepage": "https://m1nsook.github.io/NextGuide/",
  "imports": {
    "#read-file": {
      "node": "./dist/load/read-file.node.js",
      "default": "./dist/load/read-file.browser.js"
    }
  },
  "private": true
}
