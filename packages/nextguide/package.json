{
  "name": "nextguide",
  "version": "0.0.1-alpha.2",
  "description": "NextGuide — independent all-in-one Next.js documentation framework with MDX, OpenAPI, UI components, icons and themes.",
  "type": "module",
  "bin": {
    "nextguide": "bin/nextguide.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "dist/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/cli-ui.test.mjs test/account-ui-isolation.test.mjs test/account-semantics-icons.test.mjs test/doctor.test.mjs test/init.test.mjs test/distribution.test.mjs test/page.test.mjs test/page-cli.test.mjs test/version.test.mjs test/upgrade.test.mjs test/account-auth.test.mjs test/account-init.test.mjs test/account-cms.test.mjs test/extensions.test.mjs test/extension-runtime.test.mjs test/extension-storage.test.mjs test/extension-catalog.test.mjs test/extension-network.test.mjs test/extension-isolation.test.mjs test/extension-artifacts.test.mjs test/docs-chatgpt.test.mjs",
    "test:dist": "node --test test/distribution.test.mjs",
    "prepack": "node scripts/build.mjs && node --test test/cli-ui.test.mjs test/account-ui-isolation.test.mjs test/account-semantics-icons.test.mjs test/doctor.test.mjs test/init.test.mjs test/distribution.test.mjs test/page.test.mjs test/page-cli.test.mjs test/version.test.mjs test/upgrade.test.mjs test/account-auth.test.mjs test/account-init.test.mjs test/account-cms.test.mjs test/extensions.test.mjs test/extension-runtime.test.mjs test/extension-storage.test.mjs test/extension-catalog.test.mjs test/extension-network.test.mjs test/extension-isolation.test.mjs test/extension-artifacts.test.mjs test/docs-chatgpt.test.mjs",
    "test:unit": "bunx vitest run",
    "check-types": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "nextguide",
    "nextjs",
    "documentation",
    "mdx",
    "openapi",
    "shadcn",
    "lucide",
    "simple-icons"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m1nsook/NextGuide.git",
    "directory": "packages/nextguide"
  },
  "homepage": "https://m1nsook.github.io/NextGuide/",
  "bugs": {
    "url": "https://github.com/m1nsook/NextGuide/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./mdx": {
      "types": "./dist/mdx/index.d.ts",
      "default": "./dist/mdx/index.js"
    },
    "./mdx/server": {
      "types": "./dist/mdx/components/server.d.ts",
      "default": "./dist/mdx/components/server.js"
    },
    "./mdx/client": {
      "types": "./dist/mdx/components/client.d.ts",
      "default": "./dist/mdx/components/client.js"
    },
    "./mdx/plugins": {
      "types": "./dist/mdx/plugins.d.ts",
      "default": "./dist/mdx/plugins.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "default": "./dist/openapi/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./fonts": {
      "types": "./dist/fonts/index.d.ts",
      "default": "./dist/fonts/index.js"
    },
    "./fonts/catalog": {
      "types": "./dist/fonts/catalog.d.ts",
      "default": "./dist/fonts/catalog.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "default": "./dist/blocks/index.js"
    },
    "./ui/primitives": {
      "types": "./dist/ui/primitives.d.ts",
      "default": "./dist/ui/primitives.js"
    },
    "./ui/interactive": {
      "types": "./dist/ui/interactive.d.ts",
      "default": "./dist/ui/interactive.js"
    },
    "./site": {
      "types": "./dist/components/site/index.d.ts",
      "default": "./dist/components/site/index.js"
    },
    "./site.css": "./dist/components/styles/site.css",
    "./og": {
      "types": "./dist/og/index.d.ts",
      "default": "./dist/og/index.js"
    },
    "./account/server": {
      "types": "./lib/account-auth.d.mts",
      "default": "./lib/account-auth.mjs"
    },
    "./account/client": {
      "types": "./dist/account/client.d.ts",
      "default": "./dist/account/client.js"
    },
    "./account.css": "./dist/account/account.css",
    "./account/studio": {
      "types": "./dist/account/studio.d.ts",
      "default": "./dist/account/studio.js"
    },
    "./account/cms": {
      "types": "./lib/account-cms.d.mts",
      "default": "./lib/account-cms.mjs"
    },
    "./site/next": {
      "types": "./dist/components/site/next-navigation.d.ts",
      "default": "./dist/components/site/next-navigation.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "default": "./dist/extensions/index.js"
    },
    "./extensions/runtime": {
      "types": "./dist/extensions/runtime.d.ts",
      "default": "./dist/extensions/runtime.js"
    },
    "./extensions/views": {
      "types": "./dist/extensions/views.d.ts",
      "default": "./dist/extensions/views.js"
    },
    "./extensions/ui": {
      "types": "./dist/extensions/ui.d.ts",
      "default": "./dist/extensions/ui.js"
    },
    "./extensions/storage": {
      "types": "./lib/extension-storage.d.mts",
      "node": "./lib/extension-storage.mjs",
      "default": "./lib/extension-storage.mjs"
    },
    "./extensions/catalog": {
      "types": "./lib/extension-catalog.d.mts",
      "node": "./lib/extension-catalog.mjs",
      "default": "./lib/extension-catalog.mjs"
    },
    "./extensions/network": {
      "types": "./lib/extension-network.d.mts",
      "node": "./lib/extension-network.mjs",
      "default": "./lib/extension-network.mjs"
    },
    "./extensions/isolation": {
      "types": "./lib/extension-isolation.d.mts",
      "node": "./lib/extension-isolation.mjs",
      "default": "./lib/extension-isolation.mjs"
    },
    "./extensions/artifacts": {
      "types": "./lib/extension-artifacts.d.mts",
      "node": "./lib/extension-artifacts.mjs",
      "default": "./lib/extension-artifacts.mjs"
    }
  },
  "imports": {
    "#read-file": {
      "node": "./dist/openapi/load/read-file.node.js",
      "default": "./dist/openapi/load/read-file.browser.js"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.70.0",
    "monaco-editor": "0.52.2",
    "next-mdx-remote-client": "^2.1.3",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-prism-plus": "^2.0.1",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-flexible-toc": "^1.2.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.7.0",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76",
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.19.1",
    "recharts": "3.8.0",
    "tw-animate-css": "^1.4.0",
    "cn": "^0.5.2",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5"
  },
  "peerDependencies": {
    "next": "^15.5.29 || ^16.4.5",
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3",
    "@mdx-js/mdx": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "next": "16.4.5"
  }
}
