{
  "name": "@nextguide-internal/mdx",
  "version": "0.0.1-alpha.2",
  "type": "module",
  "author": "NextGuide contributors",
  "license": "MIT",
  "description": "NextGuide internal mdx build module (not published separately).",
  "keywords": [
    "mdx",
    "react",
    "nextjs",
    "documentation",
    "docs",
    "markdown",
    "nextguide"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/components/server.d.ts",
      "default": "./dist/components/server.js"
    },
    "./client": {
      "types": "./dist/components/client.d.ts",
      "default": "./dist/components/client.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "node ../../scripts/clean-dist.mjs && tsc",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@nextguide-internal/core": "workspace:*",
    "gray-matter": "^4.0.3",
    "next-mdx-remote-client": "^2.1.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-prism-plus": "^2.0.1",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-flexible-toc": "^1.2.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "server": [
        "./dist/components/server.d.ts"
      ],
      "client": [
        "./dist/components/client.d.ts"
      ],
      "plugins": [
        "./dist/plugins.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m1nsook/NextGuide.git",
    "directory": "packages/lib-mdx"
  },
  "bugs": {
    "url": "https://github.com/m1nsook/NextGuide/issues"
  },
  "homepage": "https://m1nsook.github.io/NextGuide/",
  "private": true
}
