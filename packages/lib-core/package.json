{
  "name": "@nextguide-internal/core",
  "version": "0.0.1-alpha.2",
  "type": "module",
  "author": "NextGuide contributors",
  "license": "MIT",
  "description": "NextGuide internal core build module (not published separately).",
  "keywords": [
    "nextguide",
    "documentation",
    "core"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "node ../../scripts/clean-dist.mjs && tsc",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m1nsook/NextGuide.git",
    "directory": "packages/lib-core"
  },
  "bugs": {
    "url": "https://github.com/m1nsook/NextGuide/issues"
  },
  "homepage": "https://m1nsook.github.io/NextGuide/",
  "private": true
}
